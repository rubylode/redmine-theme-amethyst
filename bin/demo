#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the throwaway Redmine this theme is developed and checked in.
#
#   ruby bin/demo up        start it, load the demo data once, switch the theme on
#   ruby bin/demo theme ID  switch to a theme folder by name, or "default" for Redmine's own look
#   ruby bin/demo restart   restart Redmine (after a stylesheet change: Redmine caches theme files until it restarts)
#   ruby bin/demo down      stop it, keep the data
#   ruby bin/demo reset     stop it and wipe the data
#
# REDMINE_TAG picks the Redmine version (7.0.2 or 7.0); the default is 7.0.2.
# The Rubylode plugins the theme dresses are mounted too when a copy is found next to this repository (or in
# RUBYLODE_PLUGINS_DIR):
# Projects, Home, To-do, Uptime Kuma, GlitchTip, Windmill, Beszel, Stats and New issue button.
# Each one is optional; without them the demo is plain Redmine, and the check skips the pages that need them.
require "json"
require "net/http"

ROOT = File.expand_path("..", __dir__)
CONFIG = JSON.parse(File.read(File.join(ROOT, "test", "config.json")))
READY_SECONDS = 240
PLUGINS_DIR = File.expand_path(ENV.fetch("RUBYLODE_PLUGINS_DIR", ".."), ROOT)
# The folder name Redmine needs for each plugin (the plugin id), and the checkout folders it may be found in, first match wins.
PLUGINS = {
  "redmine_rubylode_projects" => ["redmine-rubylode-projects"],
  "redmine_rubylode_home" => ["redmine-rubylode-home"],
  "redmine_rubylode_todo" => ["redmine-rubylode-todo"],
  "redmine_rubylode_uptime_kuma" => ["redmine-rubylode-uptime-kuma"],
  "redmine_rubylode_glitchtip" => ["redmine-rubylode-glitchtip"],
  "redmine_rubylode_windmill" => ["redmine-rubylode-windmill"],
  "redmine_rubylode_beszel" => ["redmine-rubylode-beszel"],
  "redmine_rubylode_stats" => ["redmine-rubylode-stats", "redmine-rubylode-stats-public"],
  "redmine_rubylode_new_issue_button" => ["redmine-rubylode-new-issue-button"]
}.freeze
OVERRIDE_FILE = File.join(ROOT, "docker-compose.override.yml")

def available_plugins
  PLUGINS.filter_map do |id, checkouts|
    path = checkouts.map { |checkout| File.join(PLUGINS_DIR, checkout) }.find { |folder| File.exist?(File.join(folder, "init.rb")) }
    [path, id] if path
  end
end

def plugin_available? = available_plugins.any?

def compose(*arguments)
  system("docker", "compose", *arguments, chdir: ROOT) || abort("docker compose #{arguments.join(' ')} failed")
end

# rails runner takes a file path or a piece of Ruby as its one argument.
def runner(code_or_path)
  compose("exec", "-T", "redmine", "bin/rails", "runner", code_or_path)
end

# Mounts the plugins that were found through a compose override (git-ignored), or removes the override when there are none.
def write_override
  return File.delete(OVERRIDE_FILE) if !plugin_available? && File.exist?(OVERRIDE_FILE)
  return unless plugin_available?

  volumes = available_plugins.map { |path, id| "      - #{path}:/usr/src/redmine/plugins/#{id}:ro" }
  File.write(OVERRIDE_FILE, <<~YAML)
    # Written by bin/demo. Mounts the Rubylode plugins that were found, so their pages appear in the demo.
    services:
      redmine:
        volumes:
    #{volumes.join("\n")}
  YAML
  puts "Plugins: #{available_plugins.map(&:last).join(', ')}"
end

def wait_until_ready
  uri = URI("http://localhost:#{CONFIG.fetch('port')}/login")
  deadline = Time.now + READY_SECONDS
  loop do
    begin
      return puts("Redmine is up at #{uri.host}:#{uri.port}") if Net::HTTP.get_response(uri).code == "200"
    rescue SystemCallError, EOFError, Net::ReadTimeout
      nil
    end
    abort("Redmine did not answer within #{READY_SECONDS} seconds") if Time.now > deadline
    sleep 3
  end
end

def switch_theme(id)
  value = id == "default" ? "" : id
  runner("Setting.ui_theme = #{value.inspect}; puts \"theme: \#{Setting.ui_theme.inspect}\"")
end

case ARGV.first
when "up"
  write_override
  compose("up", "-d")
  wait_until_ready
  if plugin_available?
    compose("exec", "-T", "redmine", "bundle", "exec", "rake", "redmine:plugins:migrate")
    compose("restart", "redmine")
    wait_until_ready
  end
  runner("/usr/src/redmine/seed.rb")
  switch_theme(CONFIG.fetch("theme"))
when "theme"
  switch_theme(ARGV.fetch(1) { abort("usage: ruby bin/demo theme ID|default") })
when "restart"
  compose("restart", "redmine")
  wait_until_ready
when "down"
  compose("down")
when "reset"
  compose("down", "-v")
else
  abort(File.read(__FILE__)[/\A#!.*?\n\n((?:#.*\n)+)/m, 1].to_s.gsub(/^# ?/, ""))
end
